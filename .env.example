# --- Database ---
DB_URL=jdbc:postgresql://postgres:5432/edutrack
DB_USER=edutrack
DB_PASSWORD=edutrack
POSTGRES_DB=edutrack
POSTGRES_USER=edutrack
POSTGRES_PASSWORD=edutrack

# --- Auth ---
JWT_SECRET=please-change-this-to-a-long-random-string-before-any-real-deployment
JWT_EXPIRATION_MS=86400000

# --- LLM provider: "groq" (hosted, needs GROQ_API_KEY) or "ollama" (local, needs `ollama serve` running on your machine) ---
LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama runs on your HOST machine, not in Docker. The backend container reaches it via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# --- Misc ---
# Frontend runs on host port 5174 (not 5173) because 5173/5432 were already taken by
# another project on this machine. Change both this and the frontend port in
# docker-compose.yml together if you'd rather use different ports.
CORS_ALLOWED_ORIGINS=http://localhost:5174
SEED_ENABLED=true

# --- File storage: "local" (disk, fine for dev — ephemeral on most cloud hosts) or "r2" (Cloudflare R2, needs the vars below) ---
STORAGE_PROVIDER=local
STORAGE_BASE_PATH=/app/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080

# --- Mobile (Capacitor) --- only needed when building the Android app, not for web dev
# The deployed frontend URL the Android app should load. Never commit a real school's
# actual URL here — set it in your shell before running `npx cap sync android`.
CAPACITOR_SERVER_URL=http://localhost:5174
